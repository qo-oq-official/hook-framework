{
  "output_dir": "dump_data",
  "log_file": "hook_framework.log",
  "log_level": "trace",
  "hooks": [
    {
      "module": "target_app.exe",
      "symbol": "add_numbers",
      "action": "capture",
      "collector": "typed",
      "params": [
        {"name": "a", "type": "int32"},
        {"name": "b", "type": "int32"}
      ],
      "return_type": "int32"
    },
    {
      "module": "target_app.exe",
      "symbol": "multiply_numbers",
      "action": "capture",
      "collector": "typed",
      "params": [
        {"name": "a", "type": "int32"},
        {"name": "b", "type": "int32"}
      ],
      "return_type": "int32"
    },
    {
      "module": "target_app.exe",
      "symbol": "concat_strings",
      "action": "capture",
      "collector": "typed",
      "params": [
        {"name": "a", "type": "wstring"},
        {"name": "b", "type": "wstring"}
      ],
      "return_type": "pointer"
    }
  ]
}
