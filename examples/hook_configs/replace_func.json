{
  "output_dir": "dump_data",
  "log_file": "hook_framework.log",
  "log_level": "trace",
  "hooks": [
    {
      "module": "target_app.exe",
      "symbol": "add_numbers",
      "action": "capture_and_replace",
      "collector": "typed",
      "params": [
        {"name": "a", "type": "int32"},
        {"name": "b", "type": "int32"}
      ],
      "return_type": "int32",
      "replace_module": "custom_hook.dll",
      "replace_symbol": "hooked_add_numbers"
    }
  ]
}
